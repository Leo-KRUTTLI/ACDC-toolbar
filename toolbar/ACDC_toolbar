<button>
label=Rotate axis
icon=noicon
arg=<macro>     
type = selectionType();

if (type == -1) {
    print("No line drawn");
    close();
    continue; // Skip this image if no line is drawn
}

// Get line coordinates and calculate rotation angle
getLine(x1, y1, x2, y2, lineWidth);

angle = -90 - 180 * atan2((y2 - y1), (x2 - x1)) / PI;

// Rotate image to align with the axon
run("Rotate...", "angle=" + angle + " grid=1 interpolation=Bilinear enlarge stack");

// Get current stack position and dimensions
Stack.getPosition(channel, slice, frame);
Stack.getDimensions(width, height, channels, slices, frames);

// Force refresh by switching channels
if (channels > 1) {

    nextChannel = channel + 1;

    if (nextChannel > channels)
        nextChannel = channel - 1;

    if (nextChannel >= 1) {
        Stack.setChannel(nextChannel);
        Stack.setChannel(channel);
    }
}

// Close Results window if it exists
if (isOpen("Results")) {
    selectWindow("Results");
    run("Close");
}
</macro>
